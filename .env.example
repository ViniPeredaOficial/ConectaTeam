# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Só a URL e a anon key vão para o front.
# NUNCA coloque aqui a service_role, a chave do Gemini ou o token do Telegram:
# essas ficam como secrets das Edge Functions.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# Secrets das Edge Functions: NÃO vão para o front nem para este .env.
# Configure com: npx supabase secrets set NOME=valor
#   GEMINI_API_KEY   chave do Google AI Studio (plano gratuito)
#   GEMINI_MODEL     ex.: gemini-3.5-flash
#   GEMINI_MODELOS_RESERVA  ex.: gemini-2.5-flash,gemini-3.1-flash-lite
#   GEMINI_THINKING  low (padrão) ou minimal
#   ALLOWED_ORIGINS  ex.: http://localhost:5173,https://seu-app.vercel.app
# ---------------------------------------------------------------------
